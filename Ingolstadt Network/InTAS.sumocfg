<configuration>
	<input>
		<net-file value="ingolstadt.net.xml"/>
		<route-files value="InTAS_001.1h.rou.xml"/>
		<additional-files value="additional.xml"/>
	</input>
	<output>
		<summary-output value="InTAS.summary.xml"/>
		<tripinfo-output value="InTAS.tripinfo.xml"/>
		<edgedata-output value="InTAS.travel_times.xml"/>
	</output>
	<time>
		<begin value="0"/>
		<step-length value="0.1"/>
		<end value="3600"/>
	</time>
</configuration>
