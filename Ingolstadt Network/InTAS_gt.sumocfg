<configuration>
	<input>
		<net-file value="ingolstadt.net.xml"/>
		<route-files value="InTAS_016.rou.xml, InTAS_017.rou.xml, InTAS_018.rou.xml"/>
		<additional-files value="additional_gt.xml"/>
	</input>
	<output>
		<summary-output value="InTAS.summary.xml"/>
		<tripinfo-output value="InTAS.tripinfo.xml"/>
		<edgedata-output value="InTAS.travel_times.xml"/>
	</output>
	<time>
		<begin value="57600"/>
		<step-length value="1.0"/>
		<end value="61200"/>
	</time>
</configuration>
